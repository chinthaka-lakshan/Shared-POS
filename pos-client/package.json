{
  "name": "pos-client",
  "private": true,
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.pos.client",
    "productName": "POSClient",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": "dmg",
      "hardenedRuntime": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "pinia": "^4.0.3",
    "radix-vue": "^1.9.17",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.6.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
